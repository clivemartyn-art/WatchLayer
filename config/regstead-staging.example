# Non-secret staging configuration template. Store the populated file outside Git.
DATABASE_URL=sqlite:/data/regstead.db
REGSTEAD_BASE_URL=https://staging-app.regstead.co.uk
REGSTEAD_PORTAL_ORIGIN=https://staging-app.regstead.co.uk
REGSTEAD_ENGINE_STORAGE=/data/engine
REGSTEAD_REPORT_STORAGE=/data/reports
REGSTEAD_EMAIL_SPOOL=/data/mail
REGSTEAD_ADMIN_TOKEN=replace-with-a-staging-only-random-secret
REGSTEAD_OPERATOR_TOKEN=replace-with-the-staging-operator-secret
REGSTEAD_OPERATOR=staging-operator
REGSTEAD_RELEASE=0000000000000000000000000000000000000000
REGSTEAD_STRIPE_PRODUCT_ID=prod_regstead_staging_placeholder
REGSTEAD_STRIPE_MONITOR_PRICE_ID=price_regstead_staging_placeholder
REGSTEAD_STRIPE_PORTAL_CONFIG_ID=bpc_regstead_staging_placeholder
STRIPE_SECRET_KEY=replace-with-restricted-staging-sandbox-key
STRIPE_WEBHOOK_SECRET=replace-with-staging-signing-secret
STRIPE_LIVE_MODE=false
REGSTEAD_TERMS_VERSION=monitor-2026-10-01
MONITORING_DEFAULT_CADENCE=86400000
PAYMENT_GRACE_MS=0
WORKER_CONCURRENCY=1
PORT=8080
EMAIL_PROVIDER=resend
EMAIL_FROM=replace-with-approved-staging-sender
EMAIL_REPLY_TO=support@regstead.co.uk
RESEND_API_KEY=replace-with-staging-email-key
# The Compose file supplies the exact trusted proxy address.

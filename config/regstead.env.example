# Fake placeholders only. Inject real secrets from a secret manager/environment.
DATABASE_URL=sqlite:/data/regstead.db
REGSTEAD_BASE_URL=https://regstead.example
REGSTEAD_ENGINE_STORAGE=/data/engine
REGSTEAD_REPORT_STORAGE=/data/reports
REGSTEAD_EMAIL_SPOOL=/data/mail
REGSTEAD_ADMIN_TOKEN=replace-with-a-long-random-operator-secret
REGSTEAD_OPERATOR_TOKEN=replace-with-the-same-operator-secret
REGSTEAD_OPERATOR=operator-name
REGSTEAD_RELEASE=0000000000000000000000000000000000000000
REGSTEAD_STRIPE_PRODUCT_ID=prod_regstead_placeholder
# Monitor is monthly GBP 1699 pence. Foundry Vale Ltd is not currently VAT registered.
# No VAT is currently charged and automatic Stripe Tax is not enabled.
REGSTEAD_STRIPE_MONITOR_PRICE_ID=price_monitor_placeholder
REGSTEAD_STRIPE_PORTAL_CONFIG_ID=bpc_regstead_placeholder
STRIPE_SECRET_KEY=replace-with-restricted-key-from-secret-manager
STRIPE_WEBHOOK_SECRET=replace-with-webhook-signing-secret
STRIPE_LIVE_MODE=false
REGSTEAD_TERMS_VERSION=monitor-2026-10-01
# Milliseconds; example cadence is configuration, not a customer promise.
MONITORING_DEFAULT_CADENCE=86400000
PAYMENT_GRACE_MS=0
WORKER_CONCURRENCY=1
PORT=8080
# The local default is the durable spool. Hosted staging uses the Resend adapter below.
EMAIL_PROVIDER=spool
EMAIL_FROM=reports@regstead.example
EMAIL_REPLY_TO=support@regstead.example
# Customer portal: exact HTTPS origin, no path/trailing slash.
REGSTEAD_PORTAL_ORIGIN=https://app.regstead.example
# Set only to the actual ingress socket peer; never trust arbitrary forwarded headers.
REGSTEAD_TRUSTED_PROXY_ADDRESS=::ffff:172.30.15.254
# For real staging delivery choose EMAIL_PROVIDER=resend (spool cannot deliver login links).
# Inject these outside version control; configure a provider-verified sender first.
RESEND_API_KEY=replace-with-provider-key
# EMAIL_FROM may be a plain address or `Name <address>` on that verified domain.
